# Copiar a web/.env.local (o web/.env). Ninguno de los dos se commitea.

# URL base del backend (securepassb). Default si falta: http://localhost:8080.
# El dashboard corre en el navegador de tu misma maquina, asi que localhost
# alcanza (a diferencia de mobile, que necesita la IP de la red local).
# NEXT_PUBLIC_* se inlinea al arrancar next dev / next build: despues de
# cambiarla hay que reiniciar.
NEXT_PUBLIC_API_URL=http://localhost:8080
